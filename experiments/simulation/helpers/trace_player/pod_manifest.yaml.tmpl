apiVersion: v1
kind: Pod
metadata:
  name: p-{{ .ID }}
  annotations:
    p-{{ .ID }}-fm/far-mem: "{{ .CXLMemRequest }}"
    p-{{ .ID }}-fm/cpus-distribution-over-caches: "l1-share"
spec:
  containers:
    - name: p-{{ .ID }}
      image: registry.k8s.io/pause:3.10
      resources:
        requests:
          cpu: "{{ .MilliCoresRequest }}m"
          memory: "{{ .MemoryRequest }}"
        limits:
          cpu: "{{ .MilliCoresLimit }}m"
          memory: "{{ .MemoryLimit }}"
  restartPolicy: Never